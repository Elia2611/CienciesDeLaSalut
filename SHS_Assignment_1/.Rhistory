# Chunk 1: libraries
### libraries related to knit:
library(knitr)
library(xtable)     # to create nice LaTeX tables
# Chunk 2: setting
### output options (there are a lot..):
options(width = 90, # max. width, in characters, of the R output. Default is 80.
scipen = 4)  # to avoid printing inline R output numbers in scientific
# notation if they are lower than 10^4
### set global chunk options. They apply to all chuncks except to those in which you set otherwise
opts_chunk$set(echo = TRUE,         # show R input code
eval = TRUE,         # show R output
message = TRUE,       # set to FALSE to avoid nuisance messages (be careful!)
warning = TRUE,       # set to FALSE to avoid nuisance messages (be careful!)
size = "footnotesize", # set the R output and output font size
cache = FALSE,        # useful for computationally costly chunks (be careful if set to TRUE!)
prompt = TRUE)
# Chunk 3: data
### Loading data from "copd_redux.RData" file in the working directory:
load("./copd_redux.RData")
# Chunk 4: missingness
n_obs <- nrow(copd)
n_vars <- ncol(copd)
nans <- 100*colMeans(is.na(copd))
min_nan <- sprintf("%.2f", min(nans)) # Printed with 2 decimal places using sprintf.
max_nan <- sprintf("%.2f", max(nans))
less_5 <- 100*length(nans[nans<5])/n_vars
comp_cases <- 100*mean(complete.cases(copd))
miss_total <- 100*mean(is.na(copd))
total_cells = n_obs*n_vars
# Chunk 1: libraries
### libraries related to knit:
library(knitr)
library(xtable)     # to create nice LaTeX tables
# Chunk 2: setting
### output options (there are a lot..):
options(width = 90, # max. width, in characters, of the R output. Default is 80.
scipen = 4)  # to avoid printing inline R output numbers in scientific
# notation if they are lower than 10^4
### set global chunk options. They apply to all chuncks except to those in which
### you set otherwise
opts_chunk$set(echo = FALSE,         # don't show R input code
message = TRUE,       # set to FALSE to avoid nuisance messages (be careful!)
warning = TRUE,       # set to FALSE to avoid nuisance messages (be careful!)
size = "footnotesize", # set the R output and output font size
cache = FALSE,        # useful for computationally costly chunks (be careful if set to TRUE!)
prompt = TRUE)
# Chunk 3: dataplot
### scatter plot ozone vs. wind:
par(las = 1, cex.lab = 1.3, cex.axis = 1.3)
plot(airquality$Wind,
airquality$Ozone,
xlab = "Wind speed (mph)",
ylab = "Ozone levels (ppb)",
pch = 19,
col = "gray")
# Chunk 4: modeling
### linear regression model fitting:
mod <- lm(Ozone ~ Wind, data = airquality)
### get coefficients table:
coefs <- summary(mod)$coefficients
### get beta of interest:
beta <- coefs["Wind", "Estimate"]
# Chunk 5: betaformat
### output formatting: store some stuff related to the beta of interest, to be
### used with \Sexpr{} in the report:
# first, we store the absolute value of beta:
betaabs <- abs(beta)
# now, we format it to be printed with 2 decimal places using sprintf:
betafancy <- sprintf("%.2f", betaabs)
# now we want to use "increase" or "decrease" in the report depending on if
# beta is positive or negative, respectively. We store it in the object "eff"
# (for "effect"):
eff <- ifelse(beta > 0, "increase", "decrease")
# Chunk 6: mytable
# exporting coefficients table to LaTeX format:
modtable <- xtable(coefs,
digits = c(0, 2, 2, 2, 4),
caption = "Linear regression model coefficients for wind and ozone association.",
label = "tab:coeftable")
# cosmetics for table head (LaTeX slash (\) must be doubled inside a R chunk):
colnames(modtable) <- c("\\multicolumn{1}{c}{\\bf Estimate}",
"\\multicolumn{1}{c}{\\bf Std.~Error}",
"\\multicolumn{1}{c}{\\(\\boldsymbol{t}\\)\\bf{-value}}",
"\\multicolumn{1}{c}{\\(\\boldsymbol{p}\\)\\bf{-value}}")
# format and print the table:
print(modtable,
table.placement = "ht",
size = "footnotesize",
include.rownames = TRUE,
include.colnames = TRUE,
floating = TRUE,                 # whether \begin{table} should be created (TRUE) or not (FALSE)
sanitize.text.function = force,  # important to treat content of columns as latex function
booktabs = TRUE)                 # requires \usepackage{booktabs} in the preamble of the document
# Chunk 7: modelplot
# scatter plot ozone vs. wind again (recycling code in chunk dataplot):
# we increase the font sizes to compensate the reduction that dev='tikz'
# introduces:
par(cex = 1.4)
# reuse the previous chunk named "dataplot":
### scatter plot ozone vs. wind:
par(las = 1, cex.lab = 1.3, cex.axis = 1.3)
plot(airquality$Wind,
airquality$Ozone,
xlab = "Wind speed (mph)",
ylab = "Ozone levels (ppb)",
pch = 19,
col = "gray")
# add the fitted model line:
abline(mod, col = "blue", lwd = 2)
# add legend:
legend("topright",
legend = c("Data", "Fitted model"),
col = c("gray", "blue"),
lwd = c(0, 2),   # line width
pch = c(19, NA), # point symbol
bty = "n",       # no box around the legend
cex = 1.1)       # font size (multiplier)
