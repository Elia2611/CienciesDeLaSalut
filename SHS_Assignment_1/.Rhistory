library(Ecdat)
library(fGarch)
installed.packages("fGarch")
install.packages(c("fGarch", "Ecdat"))
library(Ecdat)
library(fGarch)
data(SP500, package="Ecdat")
returnBM = SP500$r500[1805]
x = SP500$r500[(1804-2*253+1):1804]
plot(c(x, returnBM), type='l')
results = garchFit(~arma(1,0)+garch(1,1), data=x, cond.dist="std")
dfhat = as.numeric(results@fit$par[6])
forecast = predict(results, n.ahead=1)
mu = forecast$meanForecast
s = forecast$standardDeviation
pstd(-0.228, mean = mu, sd = s, nu = dfhat)
pt(((-0.228 - mu)/s) * sqrt(dfhat/(dfhat-2)),dfhat)
