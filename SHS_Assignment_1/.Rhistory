### libraries related to knit:
library(knitr)
library(xtable)
### scatter plot ozone vs. wind:
par(las = 1, cex.lab = 1.3, cex.axis = 1.3)
plot(airquality$Wind,
airquality$Ozone,
xlab = "Wind speed (mph)",
ylab = "Ozone levels (ppb)",
pch = 19,
col = "gray")
### linear regression model fitting:
mod <- lm(Ozone ~ Wind, data = airquality)
### get coefficients table:
coefs <- summary(mod)$coefficients
show(coefs)
### get beta of interest:
beta <- coefs["Wind", "Estimate"]
summary(miclust_1)
