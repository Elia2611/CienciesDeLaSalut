res75 <- age_summary("75-84")
@

    \begin{enumerate}
        \item The incidence rate among smokers was \Sexpr{sprintf("%.3f", res75$Ir_S)} coronary deaths per 1000 person-years.
        \item The incidence rate among nonsmokers was \Sexpr{sprintf("%.3f", res75$Ir_NS)} coronary deaths per 1000 person-years.
        \item The incidence rate ratio was \Sexpr{sprintf("%.3f", res75$IRR)}.
        \item The $p$-value of the Wald test to decide if the incidence rate among smokers is the same than among nonsmokers was \Sexpr{sprintf("%.4f", res75$p_value)}.
        \item Write a paragraph for the interpretation of previous results (including all quantities).
        
          Among doctors aged \Sexpr{res75$age}, the coronary death rate was \Sexpr{sprintf("%.3f", res75$Ir_S)} deaths per 1000 person-years in smokers (\Sexpr{res75$CD_S} deaths over \Sexpr{res75$PY_S} person-years) and \Sexpr{sprintf("%.3f", res75$Ir_NS)} deaths per 1000 person-years in nonsmokers (\Sexpr{res75$CD_NS} deaths over \Sexpr{res75$PY_NS} person-years). The incidence rate ratio (smokers vs.\ nonsmokers) was \Sexpr{sprintf("%.3f", res75$IRR)}, meaning that the coronary mortality rate among smokers was \Sexpr{res75$ratio_text}. The Wald test of the null hypothesis of equal incidence rates (IRR $=1$) gave \Sexpr{res75$p_text}, so at the \Sexpr{res75$alpha*100}\% significance level \Sexpr{res75$decision}. Since this is an observational study, any association should not be interpreted as causal without considering other potential confounders.
    \end{enumerate}
    

  \item Create a graphical visualization, named Figure 1, as follows:
  
  \begin{enumerate}
      \item Figure 1 must include two plots, one of them on the left and another on the right.
      
      \textbf{Hint:} Use \texttt{par(mfrow = c(1, 2), ...)}.
  
      \item Both plots must represent age groups in the horizontal axis and incidence rate ratios in the vertical axis.
  
      \item The plot on the right must represent the incidence rate ratios in logarithmic scale but its labels values must be shown in the natural scale.
      
      \textbf{Hint:} Use \texttt{plot(log = "y", ...)}.
  
      \item Both plots must include proper labels in both axes and proper ticks labels.
  
      Specifically, horizontal axis must show labels (35--44, 45--54, \ldots) and the vertical axis must show the same sequence of values in both plots. \textbf{Hint:} Use
  
<<code_hint_1, eval=FALSE>>=
  plot(..., ylim = ..., xaxt = "n")
  axis(1, at = ..., labels = ...)
@  
      
      \item Figure 1 must show a single title shared by the two plots. \textbf{Hint:} Use
  
<<code_hint_2, eval=FALSE>>=
  par(mfrow = c(1, 2), oma = c(0, 0, ..., 0))
  plot(...)  # left plot
  plot(...)  # right plot
  title(..., outer = TRUE, line = ...)
@

      \item Figure 1 must include a detailed caption.
  
  \end{enumerate}
  
  \textbf{Show your R code here for creating Figure 1.}
  
<<fig_1, fig.pos='H', fig.align='center', fig.width=10, fig.height=5, out.width='\\textwidth', fig.cap="Incidence rate ratios (IRR) of coronary death for smokers vs.\\ nonsmokers by age group. Left: IRR in the natural scale. Right: the same IRR in logarithmic scale on the vertical axis, with labels shown in the natural scale. Both plots share the same vertical axis values. The dashed horizontal line marks IRR = 1 (no difference between smokers and nonsmokers).">>=

# Data for the plots
age_groups <- Ir_IRR$Age            # labels for the horizontal axis
x_pos      <- seq_along(age_groups) # numeric positions
irr        <- Ir_IRR$IRR            # labels for the vertical axis, incidence rate ratios

# Vertical axis shared by both plots
yticks <- pretty(range(irr))        # "round" tick values covering the IRR range
yticks <- yticks[yticks > 0]        # log scale cannot display 0 or negatives
ylims  <- range(yticks, irr)        # limits that include all ticks and data

# Layout, two plots side by side, with outer margin on top for the title
par(mfrow = c(1, 2), oma = c(0, 0, 3, 0))

# Left plot: natural scale
# xaxt = "n" and yaxt = "n" suppress the default axes, which are drawn
# manually below with the desired labels and ticks
plot(x_pos, irr, type = "o", pch = 16, xlab = "Age group (years)", 
     ylim = ylims, ylab = "Incidence rate ratio", 
     main = "Natural scale", xaxt = "n", yaxt = "n")
axis(1, at = x_pos, labels = age_groups)       # horizontal axis: age groups
axis(2, at = yticks, labels = yticks, las = 1) # vertical axis: same ticks in both plots
abline(h = 1, lty = 2)                         # dashed reference line at IRR = 1

# Right plot: logarithmic scale on the vertical axis
# log = "y" plots the IRR in log scale, ylim and the tick labels are given in
# the natural scale, so the labels show the IRR values, not their logarithms
plot(x_pos, irr, type = "o", pch = 16, log = "y", xlab = "Age group (years)", 
     ylim = ylims, ylab = "Incidence rate ratio (log scale)", 
     main = "Logarithmic scale", xaxt = "n", yaxt = "n")
axis(1, at = x_pos, labels = age_groups)
axis(2, at = yticks, labels = yticks, las = 1)
abline(h = 1, lty = 2)

# Title shared by both plots
title(main = "Coronary mortality: IRR of smokers vs. nonsmokers by age group",
      outer = TRUE, line = 1)
@

  \item According to Figure 1:
  
  
<<answers_5>>=
# Data
irr_all  <- Ir_IRR$IRR                      # IRR of every age group
ages_tex     <- as.character(Ir_IRR$Age)    # age group labels

# (a) Is the IRR greater than 1 in all age groups?
all_gt1    <- all(irr_all > 1)          # TRUE if IRR > 1 everywhere
gt1_groups <- ages_tex[irr_all > 1]     # groups with IRR > 1
le1_groups <- ages_tex[irr_all <= 1]    # groups with IRR <= 1

# Vector to a list: "A", "A and B", "A, B and C"
list_groups <- function(x) {
  if (length(x) <= 1) return(x)
  paste0(paste(x[-length(x)], collapse = ", "), " and ", x[length(x)])
}

# Answer text for (a)
answer_a <- if (all_gt1) {
  # Case 1: IRR > 1 in every group
  paste0("Yes. The rate ratio is greater than 1 in all age groups, which ",
         "means that the coronary death rate is higher among smokers than ",
         "among nonsmokers in every age group.")
} else if (all(irr_all <= 1)) {
  # Case 2: IRR > 1 in no group
  paste0("No. The rate ratio is not greater than 1 in any age group, which ",
         "means that the coronary death rate among smokers is not higher ",
         "than among nonsmokers in any age group.")
} else {
  # Case 3: mixed.
  paste0("No. The rate ratio is greater than 1 in the age group",
         if (length(gt1_groups) > 1) "s " else " ",
         list_groups(gt1_groups),
         ", which means that, in ",
         if (length(gt1_groups) > 1) "these groups" else "this group",
         ", the coronary death rate is higher among smokers than among ",
         "nonsmokers. However, in the age group",
         if (length(le1_groups) > 1) "s " else " ",
         list_groups(le1_groups), " it is not greater than 1 (",
         paste(sprintf("%.2f", irr_all[irr_all <= 1]), collapse = ", "),
         "), so the death rate among smokers is not higher than among ",
         "nonsmokers.")
}

# (b) Is the IRR constant over age groups?
irr_min <- min(irr_all)
irr_max <- max(irr_all)

# We considered the IRR "aproximately constant" if the maximum is less than 
#20% above the minimum.
constant <- (irr_max / irr_min) < 1.2

# Description of the pattern with age)
trend <- if (all(diff(irr_all) < 0)) {
  "decreases with age"                        # strictly decreasing
} else if (all(diff(irr_all) > 0)) {
  "increases with age"                        # strictly increasing
} else {
  "varies with age without a monotone trend"  # neither
}

# Answer text for (b)
answer_b <- if (constant) {
  paste0("Yes, approximately. The rate ratio is roughly constant over age ",
         "groups (between ", sprintf("%.2f", irr_min), " and ",
         sprintf("%.2f", irr_max), "), which means that the association ",
         "between smoking and coronary mortality is similar in all age ",
         "groups, so age does not appear to be an effect modifier.")
} else {
  paste0("No. The rate ratio ", trend, ", ranging from ",
         sprintf("%.2f", irr_max), " to ", sprintf("%.2f", irr_min),
         ". This means that the association between smoking and coronary ",
         "mortality is not the same in all age groups, so age acts as a ",
         "potential effect modifier of the relationship between smoking ",
         "and coronary death.")
}
@
  
  \begin{enumerate}
    \item Is the rate ratio greater than 1 for all age groups? What does it means?
    
    \Sexpr{answer_a}
    
    
    \item Is the rate ratio constant over age groups? What does it means?
    
    \Sexpr{answer_b}
  \end{enumerate}

\end{enumerate}



