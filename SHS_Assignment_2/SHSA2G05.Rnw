  \textbf{Show your R code here for creating Figure 1.}
  
<<fig_1, fig.pos='H', fig.align='center', fig.width=10, fig.height=5, out.width='\\textwidth', fig.cap="Incidence rate ratios (IRR) of coronary death for smokers vs.\\ nonsmokers by age group. Left: IRR in the natural scale. Right: the same IRR in logarithmic scale on the vertical axis, with labels shown in the natural scale. Both plots share the same vertical axis values. The dashed horizontal line marks IRR = 1 (no difference between smokers and nonsmokers).">>=

# Data for the plots
age_groups <- Ir_IRR$Age            # labels for the horizontal axis
x_pos      <- seq_along(age_groups) # numeric positions
irr        <- Ir_IRR$IRR            # labels for the vertical axis, incidence rate ratios

# Vertical axis shared by both plots
yticks <- pretty(range(irr))        # "round" tick values covering the IRR range
yticks <- yticks[yticks > 0]        # log scale cannot display 0 or negatives
ylims  <- range(yticks, irr)        # limits that include all ticks and data

# Layout, two plots side by side, with outer margin on top for the title
par(mfrow = c(1, 2), oma = c(0, 0, 3, 0))

# Left plot: natural scale
# xaxt = "n" and yaxt = "n" suppress the default axes, which are drawn
# manually below with the desired labels and ticks
plot(x_pos, irr, type = "o", pch = 16, xlab = "Age group (years)", 
     ylim = ylims, ylab = "Incidence rate ratio", 
     main = "Natural scale", xaxt = "n", yaxt = "n")
axis(1, at = x_pos, labels = age_groups)       # horizontal axis: age groups
axis(2, at = yticks, labels = yticks, las = 1) # vertical axis: same ticks in both plots
abline(h = 1, lty = 2)                         # dashed reference line at IRR = 1

# Right plot: logarithmic scale on the vertical axis
# log = "y" plots the IRR in log scale, ylim and the tick labels are given in
# the natural scale, so the labels show the IRR values, not their logarithms
plot(x_pos, irr, type = "o", pch = 16, log = "y", xlab = "Age group (years)", 
     ylim = ylims, ylab = "Incidence rate ratio (log scale)", 
     main = "Logarithmic scale", xaxt = "n", yaxt = "n")
axis(1, at = x_pos, labels = age_groups)
axis(2, at = yticks, labels = yticks, las = 1)
abline(h = 1, lty = 2)

# Title shared by both plots
title(main = "Coronary mortality: IRR of smokers vs. nonsmokers by age group",
      outer = TRUE, line = 1)
@

  \item According to Figure 1:
  
  
<<answers_5>>=
# Data
irr_all  <- Ir_IRR$IRR                      # IRR of every age group
ages_tex     <- as.character(Ir_IRR$Age)    # age group labels

# (a) Is the IRR greater than 1 in all age groups?
all_gt1    <- all(irr_all > 1)          # TRUE if IRR > 1 everywhere
gt1_groups <- ages_tex[irr_all > 1]     # groups with IRR > 1
le1_groups <- ages_tex[irr_all <= 1]    # groups with IRR <= 1

# Vector to a list: "A", "A and B", "A, B and C"
list_groups <- function(x) {
  if (length(x) <= 1) return(x)
  paste0(paste(x[-length(x)], collapse = ", "), " and ", x[length(x)])
}

# Answer text for (a)
answer_a <- if (all_gt1) {
  # Case 1: IRR > 1 in every group
  paste0("Yes. The rate ratio is greater than 1 in all age groups, which ",
         "means that the coronary death rate is higher among smokers than ",
         "among nonsmokers in every age group.")
} else if (all(irr_all <= 1)) {
  # Case 2: IRR > 1 in no group
  paste0("No. The rate ratio is not greater than 1 in any age group, which ",
         "means that the coronary death rate among smokers is not higher ",
         "than among nonsmokers in any age group.")
} else {
  # Case 3: mixed.
  paste0("No. The rate ratio is greater than 1 in the age group",
         if (length(gt1_groups) > 1) "s " else " ",
         list_groups(gt1_groups),
         ", which means that, in ",
         if (length(gt1_groups) > 1) "these groups" else "this group",
         ", the coronary death rate is higher among smokers than among ",
         "nonsmokers. However, in the age group",
         if (length(le1_groups) > 1) "s " else " ",
         list_groups(le1_groups), " it is not greater than 1 (",
         paste(sprintf("%.2f", irr_all[irr_all <= 1]), collapse = ", "),
         "), so the death rate among smokers is not higher than among ",
         "nonsmokers.")
}

# (b) Is the IRR constant over age groups?
irr_min <- min(irr_all)
irr_max <- max(irr_all)

# We considered the IRR "aproximately constant" if the maximum is less than 
#20% above the minimum.
constant <- (irr_max / irr_min) < 1.2

# Description of the pattern with age)
trend <- if (all(diff(irr_all) < 0)) {
  "decreases with age"                        # strictly decreasing
} else if (all(diff(irr_all) > 0)) {
  "increases with age"                        # strictly increasing
} else {
  "varies with age without a monotone trend"  # neither
}

# Answer text for (b)
answer_b <- if (constant) {
  paste0("Yes, approximately. The rate ratio is roughly constant over age ",
         "groups (between ", sprintf("%.2f", irr_min), " and ",
         sprintf("%.2f", irr_max), "), which means that the association ",
         "between smoking and coronary mortality is similar in all age ",
         "groups, so age does not appear to be an effect modifier.")
} else {
  paste0("No. The rate ratio ", trend, ", ranging from ",
         sprintf("%.2f", irr_max), " to ", sprintf("%.2f", irr_min),
         ". This means that the association between smoking and coronary ",
         "mortality is not the same in all age groups, so age acts as a ",
         "potential effect modifier of the relationship between smoking ",
         "and coronary death.")
}
@
  
  \begin{enumerate}
    \item Is the rate ratio greater than 1 for all age groups? What does it means?
    
    \Sexpr{answer_a}
    
    
    \item Is the rate ratio constant over age groups? What does it means?
    
    \Sexpr{answer_b}
  \end{enumerate}

\end{enumerate}



\section{Modeling incidence rates with a Poisson regression model}
\label{sec:section3}



Suppose we are interested in modeling the coronary deaths rate, $Ir=\frac{I}{\Delta t}$ where $I$ is the coronary deaths count and $\Delta t$ is follow-up (in person-years), as a function of smoking status ($E$), which is the exposure of interest, and age group ($A$), as a potential confounder or as a potential effect modifier. 

To do that, we consider here the Generalized Linear Model (GLM) framework. GLM can be thought as an extension of the linear regression model for cases in which the outcome is assumed to follow a probability distribution different to the normal distribution. In the specific case in which the outcome is assumed to follow a Poisson distribution, we have a particular case of GLM named Poisson regression model. Since our outcome, the coronary mortality $I$, is a count variable, it makes sense considering here the Poisson regression model.

Regarding the role of age in the association of interest (i.e., the association between coronary mortality and smoking status), we consider two possible scenarios:

\begin{itemize}
  \item \textbf{Scenario 1:} Age could be a confounder in the association of interest, i.e., when comparing incidence rates between smokers and nonsmoker via incidence rate ratio (IRR), the comparison must be done within the same age group (i.e., we are estimating age-adjusted IRR), and we are assuming that IRR resulting of comparing smokers vs nonsmokers within each age group is the same (i.e., age-adjusted IRR does not depend on age). In this scenario, the Poisson regression model to estimate the coronary deaths rate for individuals with smoking status $i$ and in age group $j$, $Ir_{ij}$ is
  
  
\begin{equation}
\label{eq:modelmain}
\left\{
\begin{array}{l}
\bullet\ \text{Probability distribution:} \\ \\
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\qquad
I_{r_{ij}}
=
\frac{I_{ij}}{\Delta t_{ij}},
\qquad
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
I_{ij} \sim  \text{Pois}(\lambda_{ij}),
\qquad
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\Delta t_{ij}\text{ is the follow-up;}\\ \\
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\bullet\ \text{Model for the mean:} \\ \\
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\qquad
\log
\left(
\frac{\lambda_{ij}}{\Delta t_{ij}}
\right)
=
L(E_i, A_j) \text{ (the linear predictor)}\\ \\
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\qquad
L(E_i, A_j)
 = 
\alpha + \beta_i E_i + \gamma_j A_j\\
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\phantom{
\qquad
L(E_i, A_j)
}
 = 
\alpha + \\
%%%
\phantom{
\qquad
L(E_i, A_j)
} + \beta_1 \I_{i=1} + \\
%%%
\phantom{
\qquad
L(E_i, A_j)
} + 
\gamma_1 \I_{j=1} +
\gamma_2 \I_{j=2} +
\gamma_3 \I_{j=3} +
\gamma_4 \I_{j=4},
\end{array}
\right.
\end{equation}
where
\begin{equation*}
\I_{x=a}
=
\left\{
\begin{array}{ll}
1, & \text{if } x = a \\
0, & \text{if } x \neq a
\end{array}
\right..
\end{equation*}

    
    
  \item \textbf{Scenario 2:} Age could be an effect modifier\footnote{We say $Z$ is an effect modifier of the association between $X$ and $Y$ if the effect of $X$ on $Y$ depends on $Z$. For instance, in our data, age ($Z$) would be an effect modifier of the association between smoking status ($X$) and coronary mortality ($Y$) if the age-adjusted coronary mortality incidence rate ratio when comparing smokers vs nonsmokers depends on age.} in the association of interest, i.e., when comparing incidence rates between smokers and nonsmoker via IRR within the same age group (i.e., we are estimating age-adjusted IRR), the resulting IRR is not the same in all age groups (i.e., the age-adjusted IRR depends on age). In this scenario, the Poisson regression model to estimate the coronary deaths rate for individuals with smoking status $i$ and in age group $j$, $Ir_{ij}$, is

  

\begin{equation}
\label{eq:modelinter}
\left\{
\begin{array}{l}
\bullet\ \text{Probability distribution:} \\ \\
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\qquad
I_{r_{ij}}
=
\frac{I_{ij}}{\Delta t_{ij}},
\qquad
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
I_{ij} \sim  \text{Pois}(\lambda_{ij}),
\qquad
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\Delta t_{ij}\text{ is the follow-up;}\\ \\
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\bullet\ \text{Model for the mean:} \\ \\
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\qquad
\log
\left(
\frac{\lambda_{ij}}{\Delta t_{ij}}
\right)
=
L(E_i, A_j) \text{ (the linear predictor)}\\ \\
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\qquad
L(E_i, A_j)
 = 
\alpha + \beta_i E_i + \gamma_j A_j + \delta_{ij} E_i A_j\\
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\phantom{
\qquad
L(E_i, A_j)
}
 = 
\alpha + \\
%%%
\phantom{
\qquad
L(E_i, A_j)
} + \beta_1 \I_{i=1} + \\
%%%
\phantom{
\qquad
L(E_i, A_j)
} + 
\gamma_1 \I_{j=1} +
\gamma_2 \I_{j=2} +
\gamma_3 \I_{j=3} +
\gamma_4 \I_{j=4} +\\
%%%
\phantom{
\qquad
L(E_i, A_j)
} + 
\delta_{11} \I_{i=1}\I_{j=1} +
\delta_{12} \I_{i=1}\I_{j=2} +
\delta_{13} \I_{i=1}\I_{j=3} +
\delta_{14} \I_{i=1}\I_{j=4}.
\end{array}
\right.
\end{equation}
where
\begin{equation*}
\I_{x=a}
=
\left\{
\begin{array}{ll}
1, & \text{if } x = a \\
0, & \text{if } x \neq a
\end{array}
\right..
\end{equation*}


\end{itemize}

Note that, in models (\ref{eq:modelmain}) and (\ref{eq:modelinter})\footnote{You can find the \LaTeX\ code to write models (\ref{eq:modelmain}) and (\ref{eq:modelinter}) in files \texttt{mode\_main.tex} and \texttt{model\_inter.tex}, respectively.}, $Ir_{ij}$ is a random variable (different individuals with same smoking status and age can suffer or not coronary death within the same follow-up). Hence, the aim of fitting models (\ref{eq:modelmain}) and (\ref{eq:modelinter}) is to estimate the expectation (i.e., mean) of the coronary deaths rate as:

\begin{equation}
\tag{a}
\label{eq:eqA}
\mathbb{E}(I_{r_{ij}})=\mathbb{E}\left(\frac{I_{ij}}{\Delta t_{ij}}\right)=\frac{\mathbb{E}(I_{ij})}{\Delta t_{ij}}=\frac{\lambda_{ij}}{\Delta t_{ij}}=\exp(L(E_{i},A_{j})).
\end{equation}


\begin{enumerate}
  \item Note that the logarithm function in models (\ref{eq:modelmain}) and (\ref{eq:modelinter}) implies that we are assuming that the incidence rate varies exponentially with age. Is that assumption reasonable based on information provided by Figure \ref{fig:fig_1}? Why?

  \item Prove that, under model (\ref{eq:modelmain}), the age-adjusted expected IRR for smokers vs nonsmokers in group \(j\) does not depend on age and it is:

  \begin{equation}
  \label{eq:eq3}
  IRR_{j}=\exp(\beta_{1}), \quad \forall j.
  \end{equation}

  

Taking the definition of $IRR_j$ based on the expected incidence rates, together with the relation $\mathbb{E}(I_{r_{ij}})=\exp(L(E_{i},A_{j}))$ demonstrated in (\ref{eq:eqA}), we obtain:
  
  \begin{equation*}
  \begin{aligned}
    IRR_{j} &= \frac{ \mathbb{E}(I_{r_{1j}}) }
                    { \mathbb{E}(I_{r_{0j}}) } \\ 
            &= \frac{ \exp(L(E_{1},A_{j})) }
                    { \exp(L(E_{0},A_{j})) } \\ 
            &= \exp(L(E_{1},A_{j}) - L(E_{0},A_{j}))
  \end{aligned}
  \end{equation*}

Now we substitute model (\ref{eq:modelmain}):

  \begin{equation*}
  \begin{aligned}
    IRR_{j} &= \exp(\alpha+\beta_{1}E_{1}+\gamma_{j}A_{j} - (\alpha+\beta_{0}E_{0}+\gamma_{j}A_{j})) \\ 
            &= \exp(\beta_{1}E_{1} - \beta_{0}E_{0}))
  \end{aligned}
  \end{equation*}
  
We can observe that the age group term $A_j$ cancels out, implying that the age-adjusted IRR does not depend on age.
Furthermore, since $E_1=1$ for smokers and $E_0=0$ for nonsmokers, we obtain

  \begin{equation*}
    IRR_{j} = \exp(\beta_{1})
  \end{equation*}
  
Thus, proving (\ref{eq:eq3}) and that the age-adjusted expected IRR for smokers vs nonsmokers in group j does not depend on age.\\



  \item Prove that, under model (\ref{eq:modelinter}), the age-adjusted expected IRR for smokers vs nonsmokers in group \(j\) depends on age and it is:
  
  \begin{equation}
  \label{eq:eq4}
  IRR_{j}=\begin{cases}
  \exp(\beta_{1}), & \text{if } j=0 \\
  \exp(\beta_{1}+\delta_{1j}), & \text{if } j\ne 0
  \end{cases}
  \end{equation}
  
Following the same reasoning as in the previous exercise

\begin{equation*}
  \begin{aligned}
    IRR_{j} &= \frac{ \mathbb{E}(I_{r_{1j}}) }
                    { \mathbb{E}(I_{r_{0j}}) } \\ 
            &= \frac{ \exp(L(E_{1},A_{j})) }
                    { \exp(L(E_{0},A_{j})) } \\ 
            &= \exp(L(E_{1},A_{j}) - L(E_{0},A_{j}))
  \end{aligned}
  \end{equation*}

Now we substitute model (\ref{eq:modelinter}):

  \begin{equation*}
  \begin{aligned}
    IRR_{j} &= \exp(\alpha+\beta_{1}E_{1}+\gamma_{j}A_{j}+\delta_{1j}E_{1}A_{j} - 
               (\alpha+\beta_{0}E_{0}+\gamma_{j}A_{j}+\delta_{0j}E_{0}A_{j})) \\ 
            &= \exp(\beta_{1}E_{1} - \beta_{0}E_{0} + \delta_{1j}E_{1}A_{j} - \delta_{0j}E_{0}A_{j})
  \end{aligned}
  \end{equation*}

Since $E_1=1$ for smokers and $E_0=0$ for nonsmokers, we obtain:

 \begin{equation*}
  \begin{aligned}
    IRR_{j} &= \exp(\beta_{1} + \delta_{1j}A_{j})
  \end{aligned}
  \end{equation*}
  
Therefore, the age-adjusted IRR depends on the age group through the term $\delta_{1j}A_{j}$.\\

For the baseline age group ($j=0$) no interaction parameter $\delta_{10}$ is included in the model, therefore 
  
    \begin{equation*}
      IRR_{j} = \exp(\beta_{1})
    \end{equation*}
  
For the remaining age groups ($j\ne 0$) we have 
  
  \begin{equation*}
  \begin{aligned}
    IRR_{j} &= \exp(\beta_{1} + \delta_{1j}A_{j}) \\
            &= \exp(\beta_{1} + \delta_{11}\I_{j=1} + \delta_{12}\I_{j=2} +\delta_{13}\I_{j=3} + \delta_{14}\I_{j=4})\\
  \end{aligned}
  \end{equation*}
  
  Using the definition of $\I_{x=a}$ in (\ref{eq:modelinter}), only one  $\I$ variable is equal to 1 for a given age group $j$, while all the others are equal to 0. Therefore,

  \begin{equation*}
  \begin{aligned}
    IRR_{j} &= \exp(\beta_{1} + \delta_{1j}\I_{j=j}) \\
            &= \exp(\beta_{1} + \delta_{1j})
  \end{aligned}
  \end{equation*}
  
Which proves (\ref{eq:eq4}). Therefore, the age-adjusted expected IRR for smokers versus nonsmokers depends on age, indicating that age acts as an effect modifier of the association between smoking and coronary mortality.\\


  \item According to Figure \ref{fig:fig_1}, explain what sign (i.e., positive, negative or zero) do you expect for \(\delta_{1j}\) in model (\ref{eq:modelinter}).

  \item Now, we fit models (\ref{eq:modelmain}) and (\ref{eq:modelinter}) in R:


<<code_ex3_5_a, eval=TRUE>>=
### model without the term for the interaction between smoking status and
### age. Under this model, age is considered as a potential confounder:
mod1 <- glm(deaths ~ smoker + age + offset(log(personYears)),
            family = poisson,
            data = breslow)
### summary of mod1 fitting:
summary(mod1)

### model with the term for the interaction between smoking status and age.
### Under this model, age is considered as a potential effect modifier,
### i.e., the effect of smoking on mortality depends on age:
mod2 <- glm(deaths ~ smoker * age + offset(log(personYears)),
            family = poisson,
            data = breslow)
### summary of mod2 fitting:
summary(mod2)
@  


The only difference between models (\ref{eq:modelmain}) and (\ref{eq:modelinter}) is the interaction term $\delta_{ij}E_{i}A_{j}$ included in model (\ref{eq:modelinter}). Now, we test the significance of this interaction term using the Likelihood-ratio test (LRT) and setting a significance level of 0.05. In this LRT, the null hypothesis is that $\delta_{ij}E_{i}A_{j}=0$, i.e., that models (\ref{eq:modelmain}) and (\ref{eq:modelinter}) are the same model:

<<code_ex3_5_b, eval=TRUE>>=
### lLikelihood-ratio test (LRT) for the interaction term:
anova(mod1, mod2, test = "LRT")
@

According to the p-value $=0.0164<0.05$, we reject the null hypothesis. Accordingly, from now on, we discard model (\ref{eq:modelmain}) and \textbf{continue the exercise using model} (\ref{eq:modelinter}) \textbf{(i.e., the fitted model \texttt{mod2})}. As a consequence, we are assuming that age is an effect modifier.

  \item According to the fitted model \texttt{mod2}, complete the following list \textbf{(using \texttt{\textbackslash Sexpr} in your Rnw document)}:
    \begin{itemize}
        \item $\hat{\alpha} = \Sexpr{coef(mod2)["(Intercept)"]}$ 
        \item $\hat{\beta}_{1} = \Sexpr{coef(mod2)["smokeryes"]}$  
        \item $\hat{\gamma}_{1} = \Sexpr{coef(mod2)["age45-54"]}$  
        \item $\hat{\gamma}_{2} = \Sexpr{coef(mod2)["age55-64"]}$   
        \item $\hat{\gamma}_{3} = \Sexpr{coef(mod2)["age65-74"]}$  
        \item $\hat{\gamma}_{4} = \Sexpr{coef(mod2)["age75-84"]}$  
        \item $\hat{\delta}_{1} = \Sexpr{coef(mod2)["smokeryes:age45-54"]}$  
        \item $\hat{\delta}_{2} = \Sexpr{coef(mod2)["smokeryes:age55-64"]}$ 
        \item $\hat{\delta}_{3} = \Sexpr{coef(mod2)["smokeryes:age65-74"]}$ 
        \item $\hat{\delta}_{4} = \Sexpr{coef(mod2)["smokeryes:age75-84"]}$ 
    \end{itemize}


  \item Use formula (4) and estimates provided by \texttt{summary(mod2)} to complete the following list \textbf{(using \texttt{\textbackslash Sexpr} in your Rnw document)}:
  
    
<<s3_ex7>>=

# Estimated coefficients of model (2)
coefs_mod2 <- coef(mod2)

# Beta1: main effect of smoking
beta1 <- coefs_mod2["smokeryes"]

# Deltas: interaction terms between smoking and age
delta1 <- coefs_mod2[grep("smoker.*:", names(coefs_mod2))]

# IRR in age group j, using formula (4):
IRR <- function(j){
  if (j==0) {
    exp(beta1)
  } else {
    exp(beta1 + delta1[j])
  }
}

@

    \begin{itemize}
        \item $\widehat{IRR}_{35-44} = \Sexpr{IRR(0)}$
        \item $\widehat{IRR}_{45-54} = \Sexpr{IRR(1)}$
        \item $\widehat{IRR}_{55-64} = \Sexpr{IRR(2)}$ 
        \item $\widehat{IRR}_{65-74} = \Sexpr{IRR(3)}$ 
        \item $\widehat{IRR}_{75-84} = \Sexpr{IRR(4)}$
    \end{itemize}

\item Solve again questions 2. and 3. (only (a), (b) and (c)) in Section \ref{sec:section2}, but using now model (\ref{eq:modelinter}), formula \ref{eq:eq4} and coefficients estimates provided by \texttt{summary(mod2)}. Check that you get identical results. What do you think is the reason for this? 


\textbf{Show your R code here.}

<<s3_ex8>>=

# Coefficients of model (2) needed to compute the rates
# (beta1, delta1 and IRR(j) are reused from exercise 7)

alpha <- coefs_mod2["(Intercept)"]
gamma <- coefs_mod2[grep("^age", names(coefs_mod2))]


# Expected incidence rate among nonsmokers (i=0) in age group j, per 1000 person-years. 
# When i = 0, I_{i=1} = 0, and the terms beta1 and delta disappear:

Ir_ns <- function(j){
  if (j == 0){
    exp(alpha) * 1000
  } else {
    exp(alpha + gamma[j]) * 1000
  }
}

# Expected incidence rate among smokers (i=1) in age group j, per 1000 person-years. 
# When i = 1, I_{i=1} = 1, so beta1 and delta are included:

Ir_s <- function(j){
  if (j == 0){
    exp(alpha + beta1) * 1000
  } else {
    exp(alpha + beta1 + gamma[j] + delta1[j]) * 1000
  }
}

# Question 2 of section 2: age group 45-54 (j=1):
Ir_s45 <- Ir_s(1)
Ir_ns45 <- Ir_ns(1)
IRR_45 <- IRR(1)

# Question 3 of section 2: age group 75-84 (j=4):
Ir_s75 <- Ir_s(4)
Ir_ns75 <- Ir_ns(4)
IRR_75 <- IRR(4)

@

\textbf{Age group 45-54:}

\begin{enumerate}
        \item The incidence rate among smokers was \Sexpr{sprintf("%.3f", Ir_s45)} coronary deaths per 1000 person-years.
        \item The incidence rate among nonsmokers was \Sexpr{sprintf("%.3f", Ir_ns45)} coronary deaths per 1000 person-years.
        \item The incidence rate ratio was \Sexpr{sprintf("%.3f", IRR_45)}.
        
\end{enumerate}

        
\textbf{Age group 75-84:}

\begin{enumerate}
        \item The incidence rate among smokers was \Sexpr{sprintf("%.3f", Ir_s75)} coronary deaths per 1000 person-years.
        \item The incidence rate among nonsmokers was \Sexpr{sprintf("%.3f", Ir_ns75)} coronary deaths per 1000 person-years.
        \item The incidence rate ratio was \Sexpr{sprintf("%.3f", IRR_75)}.
        
\end{enumerate}



<<s3_ex8_check>>=

# Comparison of model (2) results with Section 2 results
comparison <- data.frame(
  Age = c("45-54", "45-54", "45-54", "75-84", "75-84", "75-84"),
  Type = c("Rate smokers", "Rate nonsmokers", "IRR",
           "Rate smokers", "Rate nonsmokers", "IRR"),
  section2 = c(res45$Ir_S, res45$Ir_NS, res45$IRR,
               res75$Ir_S, res75$Ir_NS, res75$IRR),
  mod2 = c(Ir_s45, Ir_ns45, IRR_45,
           Ir_s75, Ir_ns75, IRR_75))
  
comparison

identical_res <- all.equal(comparison$section2, comparison$mod2)
identical_res
@


<<s3_ex8_text, echo=FALSE>>=
n_par   <- length(coef(mod2))   # number of parameters of model (2)
n_obs   <- nrow(breslow)        # number of observations
df_res  <- df.residual(mod2)    # residual degrees of freedom
dev_res <- round(deviance(mod2), 3)   # residual deviance 

if (identical_res && n_par == n_obs) {
  reason <- paste0("The results obtained with model (2) are identical to those ",
                   "obtained in questions 2 and 3 of Section 2. Model (2) has ",
                   n_par, " parameters for ", n_obs, " observations, so it has ",
                   df_res, " residual degrees of freedom and a residual deviance of ",
                   dev_res, ". Therefore, the model fits the data perfectly.")
} else {
  reason <- paste0("The results obtained with model (2) are not identical to those ",
                   "obtained in questions 2 and 3 of Section 2. Model (2) has ",
                   n_par, " parameters for ", n_obs, " observations, so it has ",
                   df_res, " residual degrees of freedom and a residual deviance of ",
                   dev_res, ". Therefore, the model does not reproduce the data exactly.")
}
@

\Sexpr{reason}

\end{enumerate}


