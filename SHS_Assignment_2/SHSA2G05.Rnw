\section{Comparing incidence rates}
\label{sec:section2}
\begin{enumerate}
    \item Add extra columns in Table~\ref{tab:coronary} for:
    \begin{enumerate}
        \item $I_{r_{ij}}$, the sample coronary death rates per 1000 person-years for smoking status $i$ ($i = 0$ for nonsmokers and $i = 1$ for smokers) in age group $j$ ($j = 0, 1, \dots, 4$ for 35-44, 45-54, \dots, 75-84, respectively) (two columns, one for each smoking status).
    
        \item $\text{IRR}_j = \frac{I_{r_{1j}}}{I_{r_{0j}}}$, the incidence rate ratio for smokers vs.\ nonsmokers in age group $j$ (one column).
    \end{enumerate}
    
    Print the updated table as Table 2, with a proper caption.
    
    \textbf{Show your code here for creating Table 2.}
    
<<Ir_and_IRR_data, results='asis'>>=
# Sample incidence rates (deaths per 1000 person-years)
# The data are stored in "long" format (one row per age group and smoking
# status), so we first select the rows of each status.
Ir_Nonsmokers <- breslow$deaths[breslow$smoker == "no"] / 
    breslow$personYears[breslow$smoker == "no"] * 1000
Ir_Smokers <- breslow$deaths[breslow$smoker == "yes"] / 
    breslow$personYears[breslow$smoker == "yes"] * 1000

# Data frame, one row per age group,
# Contains person-years, coronary deaths, incidence rates and the IRR
# (smokers vs. nonsmokers) for each age group.
Ir_IRR <- data.frame(
  Age = breslow$age[breslow$smoker == "no"],
  Nonsmokers_py = breslow$personYears[breslow$smoker == "no"],
  Smokers_py = breslow$personYears[breslow$smoker == "yes"],
  Nonsmokers_cd = breslow$deaths[breslow$smoker == "no"],
  Smokers_cd = breslow$deaths[breslow$smoker == "yes"],
  Nonsmokers_Ir = Ir_Nonsmokers,
  Smokers_Ir = Ir_Smokers,
  IRR = Ir_Smokers / Ir_Nonsmokers      # IRR_j = I_r1j / I_r0j
)

# Create the LaTeX table with xtable
tab_ir_irr <- xtable(Ir_IRR, 
                 # One value per column, including the row names
                 # (0 decimals for counts, 2 for rates and IRR)
                 digits = c(0, 0, 0, 0, 0, 0, 2, 2, 2),
                 # Column alignment (row names + 8 columns)
                 align = c("l", "r", "r", "r", "r", "r", "r", "r", "r"),
                 # Self-contained caption, defines i, j, I_r and IRR
                 caption = paste0("Coronary deaths and person-years by age ",
                 "group and smoking status, with sample incidence rates ",
                 "($I_{r_{ij}}$, deaths per 1000 person-years) for smoking ",
                 "status $i$ ($i = 0$ nonsmokers, $i = 1$ smokers) and age ",
                 "group $j$ ($j = 0, \\dots, 4$ for 35--44, \\dots, 75--84), ",
                 "and incidence rate ratios ($\\mathrm{IRR}_j = ",
                 "I_{r_{1j}}/I_{r_{0j}}$, smokers vs.\\ nonsmokers). ",
                 "British doctors' study, first ten years of follow-up."),
                 label = "tab:rates")   # used to reference it with \ref{}

# Names of the second header row, the first one is added below.
colnames(tab_ir_irr) <- c("Age", "Nonsmokers", "Smokers", "Nonsmokers", 
                      "Smokers", "Nonsmokers", "Smokers", "IRR")

# Extra header row with grouped column titles
# Inserted above the column names (position -1). Each \multicolumn spans the
# two columns (nonsmokers, smokers) of one variable. The first and last cells
# are empty (Age and IRR). \cmidrule draws a line under each group.
addtorow <- list()
addtorow$pos <- list(-1)
addtorow$command <- paste0(
  "\\toprule\n &",
  "\\multicolumn{2}{c}{Person-years} & ",
  "\\multicolumn{2}{c}{Coronary deaths} & ",
  "\\multicolumn{2}{c}{$I_{r_{ij}}$ (per 1000 p-y)} &",
  "\\\\\n",
  "\\cmidrule(lr){2-3} \\cmidrule(lr){4-5} \\cmidrule(lr){6-7}\n"
)

# Print the table as LaTeX
print(tab_ir_irr,
      table.placement = "H",            
      include.rownames = FALSE,         # Do not print row numbers
      include.colnames = TRUE,          # Print the column names
      add.to.row = addtorow,            # Add the grouped header
      hline.after = c(0, nrow(Ir_IRR)), # Rules after the header and at the end
      booktabs = TRUE)                  
@



    \item For age group 45-54, complete the following sentences with numbers and proper units \textbf{(using \texttt{\textbackslash Sexpr} in your \texttt{Rnw} document)}:
<<age_summary_function>>=
# Summary of one age group: rates, IRR, Wald test and automatic text
# age:   age group label exactly as in Ir_IRR$Age (e.g. "45-54")
# data:  data frame with the table of rates (default: Ir_IRR)
# alpha: significance level for the Wald test (default: 0.05)
age_summary <- function(age, data = Ir_IRR, alpha = 0.05) {
  idx <- data$Age == age

  # Quantities for the selected age group
  Ir_S  <- data$Smokers_Ir[idx]
  Ir_NS <- data$Nonsmokers_Ir[idx]
  IRR   <- data$IRR[idx]
  CD_S  <- data$Smokers_cd[idx]
  CD_NS <- data$Nonsmokers_cd[idx]
  PY_S  <- data$Smokers_py[idx]
  PY_NS <- data$Nonsmokers_py[idx]

  # Wald test for the rate ratio (nonsmokers = reference row)
  wald_test    <- rateratio.wald(matrix(c(CD_NS, CD_S, PY_NS, PY_S), 2, 2))
  p_value_wald <- wald_test$p.value[2, "wald"]

  # Text that depends on the results
  significant <- p_value_wald < alpha
  direction   <- if (IRR > 1) "higher" else if (IRR < 1) "lower" else "the same"

  decision <- if (significant) {
    paste0("we reject the null hypothesis and conclude that the coronary ",
           "mortality rate among smokers is ", direction,
           " than among nonsmokers in this age group")
  } else {
    paste0("we do not reject the null hypothesis, as there is not enough ",
           "evidence of a difference in coronary mortality rates between ",
           "smokers and nonsmokers in this age group")
  }

  # Text describing the IRR
  ratio_text <- if (IRR >= 1) {
    paste0("about ", sprintf("%.1f", IRR), " times that of nonsmokers")
  } else {
    paste0("about ", sprintf("%.1f", (1 - IRR) * 100),
           "\\% lower than that of nonsmokers")
  }

  p_text <- format.pval(p_value_wald, digits = 3, eps = 0.0001)
  p_text <- if (p_value_wald < 0.0001) paste0("p ", p_text) else paste0("p = ", p_text)

  # Return everything in a named list
  list(age = age, Ir_S = Ir_S, Ir_NS = Ir_NS, IRR = IRR,
       CD_S = CD_S, CD_NS = CD_NS, PY_S = PY_S, PY_NS = PY_NS,
       p_value = p_value_wald, p_text = p_text, alpha = alpha,
       significant = significant, decision = decision,
       ratio_text = ratio_text)
}


@

<<sentences_45>>=
# Quantities and texts for age group 45-54.
res45 <- age_summary("45-54")
@

    \begin{enumerate}
        \item The incidence rate among smokers was \Sexpr{sprintf("%.3f", res45$Ir_S)} coronary deaths per 1000 person-years.
        \item The incidence rate among nonsmokers was \Sexpr{sprintf("%.3f", res45$Ir_NS)} coronary deaths per 1000 person-years.
        \item The incidence rate ratio was \Sexpr{sprintf("%.3f", res45$IRR)}.
        \item The $p$-value of the Wald test to decide if the incidence rate among smokers is the same than among nonsmokers was \Sexpr{sprintf("%.4f", res45$p_value)}.
        \item Write a paragraph for the interpretation of previous results (including all quantities).
        
          Among doctors aged \Sexpr{res45$age}, the coronary death rate was \Sexpr{sprintf("%.3f", res45$Ir_S)} deaths per 1000 person-years in smokers (\Sexpr{res45$CD_S} deaths over \Sexpr{res45$PY_S} person-years) and \Sexpr{sprintf("%.3f", res45$Ir_NS)} deaths per 1000 person-years in nonsmokers (\Sexpr{res45$CD_NS} deaths over \Sexpr{res45$PY_NS} person-years). The incidence rate ratio (smokers vs.\ nonsmokers) was \Sexpr{sprintf("%.3f", res45$IRR)}, meaning that the coronary mortality rate among smokers was \Sexpr{res45$ratio_text}. The Wald test of the null hypothesis of equal incidence rates (IRR $=1$) gave \Sexpr{res45$p_text}, so at the \Sexpr{res45$alpha*100}\% significance level \Sexpr{res45$decision}. Since this is an observational study, any association should not be interpreted as causal without considering other potential confounders.
    \end{enumerate}


